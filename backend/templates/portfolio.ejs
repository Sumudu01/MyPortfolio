<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profile.name %> - Portfolio</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #f4f4f4; }
        .container { max-width: 800px; margin: 0 auto; padding: 20px; background: white; }
        h1 { color: #333; }
        .section { margin-bottom: 20px; }
        ul { list-style-type: none; padding: 0; }
        li { margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <h1><%= profile.name %></h1>
        <p><%= profile.bio %></p>
        
        <div class="section">
            <h2>Skills</h2>
            <ul>
                <% profile.skills.forEach(skill => { %>
                    <li><%= skill %></li>
                <% }) %>
            </ul>
        </div>
        
        <div class="section">
            <h2>Experience</h2>
            <ul>
                <% profile.experience.forEach(exp => { %>
                    <li><strong><%= exp.title %></strong> at <%= exp.company %> (<%= exp.duration %>)<br><%= exp.description %></li>
                <% }) %>
            </ul>
        </div>
        
        <div class="section">
            <h2>Education</h2>
            <ul>
                <% profile.education.forEach(edu => { %>
                    <li><%= edu.degree %> from <%= edu.institution %> (<%= edu.year %>)</li>
                <% }) %>
            </ul>
        </div>
        
        <div class="section">
            <h2>Projects</h2>
            <ul>
                <% profile.projects.forEach(proj => { %>
                    <li><a href="<%= proj.link %>"><%= proj.title %></a><br><%= proj.description %></li>
                <% }) %>
            </ul>
        </div>
        
        <div class="section">
            <h2>Contact</h2>
            <p>Phone: <%= profile.contact.phone %></p>
            <p>LinkedIn: <a href="<%= profile.contact.linkedin %>"><%= profile.contact.linkedin %></a></p>
            <p>GitHub: <a href="<%= profile.contact.github %>"><%= profile.contact.github %></a></p>
        </div>
    </div>
</body>
</html>